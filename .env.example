# Public site URL used for canonical links, the sitemap, and Open Graph.
PUBLIC_SITE_URL=https://example.com

# Comma-separated inboxes that receive booking and contact emails.
MANAGER_EMAIL=manager@example.com

# From address on those emails.
EMAIL_FROM="Morrell's <bookings@example.com>"

# Real mail. Leave SMTP_HOST empty until the salon mailbox is ready.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ethereal sends a test message and prints a preview URL in the server log.
# Do not use ethereal on the live site.
EMAIL_MODE=

# How many bookings can share one start time.
CHAIRS=2

# Optional. Online card charging only runs when this is set AND a service has a price in pence.
# This site does not ask guests to type a card number.
STRIPE_SECRET_KEY=
