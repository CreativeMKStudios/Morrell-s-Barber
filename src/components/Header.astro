---
import { withBase } from "../lib/url.ts";
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = (href: string) => (withBase(href).replace(/\/$/, "") || "/") === here;
const links = [
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/reviews", label: "Reviews" },
  { href: "/contact", label: "Contact" },
];
const tabs = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/book", label: "Book" },
  { href: "/contact", label: "Contact" },
];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href={withBase("/")}>Morrell's</a>
    <nav class="nav-main" aria-label="Main">
      {links.map((link) => (
        <a href={withBase(link.href)} aria-current={current(link.href) ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>
    <a class="header-phone" href="tel:+441536481561">01536 481561</a>
    <a class="btn header-book" href={withBase("/book")}>Book</a>
  </div>
</header>
<nav class="tabbar" aria-label="Mobile">
  {tabs.map((link) => (
    <a href={withBase(link.href)} aria-current={current(link.href) ? "page" : undefined}>{link.label}</a>
  ))}
</nav>
