---
import "@fontsource/outfit/latin-400.css";
import "@fontsource/outfit/latin-600.css";
import "@fontsource/outfit/latin-700.css";
import "@fontsource/fraunces/latin-600-italic.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { jsonLd } from "../lib/schema.ts";
import { withBase } from "../lib/url.ts";

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  schemas?: unknown[];
}
const { title, description, path, noindex = false, schemas = [] } = Astro.props;
const canonical = new URL(withBase(path), Astro.site).href;
const image = new URL(withBase("/images/og.jpg"), Astro.site).href;
const fullTitle = title.includes("Morrell") ? title : `${title} | Morrell's Kettering`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" hreflang="en-GB" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="theme-color" content="#efe9e2" />
    <meta name="geo.region" content="GB-NNH" />
    <meta name="geo.placename" content="Kettering" />
    <meta name="geo.position" content="52.4005658;-0.7293985" />
    <meta name="ICBM" content="52.4005658, -0.7293985" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Morrell's" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Morrell's shop front at 2 Trafalgar Road, Kettering" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="manifest" href={withBase("/site.webmanifest")} />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={jsonLd(schema)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
