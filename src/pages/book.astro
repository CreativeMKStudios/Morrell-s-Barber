---
import Base from "../layouts/Base.astro";
import { salon, services } from "../data/salon.ts";
import { formatMinutes } from "../data/salon.ts";
import { breadcrumbSchema } from "../lib/schema.ts";
import { withBase } from "../lib/url.ts";
const description = "Book a hair appointment at Morrell's, 2 Trafalgar Road, Kettering. Pick a service, a day, and a time. Pay in the salon or ask to pay online.";
const crumbs = [{ name: "Home", path: "/" }, { name: "Book", path: "/book" }];
---
<Base title="Book a hair appointment | Morrell's Kettering" description={description} path="/book" schemas={[breadcrumbSchema(Astro.site, crumbs)]}>
  <div class="wrap book-top">
    <img class="book-photo" src={withBase("/images/shop-1600.webp")} alt="Morrell's shop front on Trafalgar Road, Kettering." width="1600" height="1200" fetchpriority="high" />
    <form id="book-form" class="sheet" method="post" action={withBase("/api/book")}>
      <div class="sheet-head">
        <div>
          <h1>Morrell's</h1>
          <p><span class="star">★</span> {salon.rating} ({salon.reviewCount}) <span class="orange">Hairdresser</span></p>
        </div>
      </div>
      <nav class="tabs" aria-label="Salon sections">
        <a href={withBase("/book")} aria-current="page">Booking</a>
        <a href={withBase("/about")}>About</a>
        <a href={withBase("/reviews")}>Reviews</a>
      </nav>

      <fieldset>
        <legend><strong>Service</strong></legend>
        <div class="fields">
          {services.map((service, index) => (
            <label class="choice">
              <input type="radio" name="serviceId" value={service.id} checked={index === 0} required />
              <strong>{service.name}</strong>
              <span class="fine"> · {formatMinutes(service.minutes)} · price in the salon</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="cal-head">
        <button class="icon-btn" type="button" data-prev aria-label="Previous month">‹</button>
        <h2 data-month-label>Month</h2>
        <button class="icon-btn" type="button" data-next aria-label="Next month">›</button>
      </div>
      <div class="dow" aria-hidden="true"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
      <div class="days" data-days role="group" aria-label="Choose a day"></div>
      <h2>Time</h2>
      <div class="times" data-times role="group" aria-label="Choose a time"></div>
      <p class="summary" data-summary><span>Choose a day</span><strong>Choose a time</strong></p>

      <div class="fallback">
        <p class="fine">If the calendar does not load, type the day and time here. Closed Monday, Thursday, and Sunday.</p>
        <div class="fields">
          <label><span>Date</span><input name="date" type="date" /></label>
          <label><span>Start time</span><input name="time" type="time" step="1800" /></label>
        </div>
      </div>

      <h2>How you will pay</h2>
      <div class="choices">
        <label class="choice">
          <input type="radio" name="payment" value="salon" checked />
          <strong>Pay in the salon</strong>
          <span class="fine">Pay on the day. No card is taken now.</span>
        </label>
        <label class="choice">
          <input type="radio" name="payment" value="online" />
          <strong>Pay online</strong>
          <span class="fine">Ask to pay by card. This page never takes your card number.</span>
        </label>
      </div>
      <p class="fine">Online card taking only runs when the salon has switched it on. Until then, a pay-online booking is still held, and you pay in the shop unless they send a link.</p>

      <div class="fields">
        <label class="hp">Company <input name="company" tabindex="-1" autocomplete="off" /></label>
        <label><span>Your name</span><input name="name" required autocomplete="name" /></label>
        <label><span>Email</span><input name="email" type="email" required autocomplete="email" /></label>
        <label><span>Phone</span><input name="phone" type="tel" required autocomplete="tel" /></label>
        <label><span>Stylist, if you have one</span><input name="stylist" maxlength="80" /></label>
        <label><span>Notes</span><textarea name="notes" maxlength="500"></textarea></label>
      </div>
      <p class="error" data-error role="alert"></p>
      <button class="btn btn-block" type="submit">Book now</button>
      <p class="fine">We email you and the salon. If that time is already taken in the salon's own diary, they will phone you. Read the <a href={withBase("/booking-terms")}>booking terms</a>.</p>
    </form>
  </div>
</Base>
<script>
  import "../scripts/booking.ts";
</script>
